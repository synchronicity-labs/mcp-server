# Sync API base URL
SYNC_BASE_URL=https://api.sync.so

# OAuth issuer URL — set to your ngrok/tunnel URL for local testing
MCP_ISSUER_URL=https://<your-ngrok-url>

# Shared secret for OAuth client registration (must match the API's OAUTH_REGISTRATION_SECRET)
OAUTH_REGISTRATION_SECRET=your-secret-here

# Structured runtime heartbeat interval for production diagnostics
MCP_RUNTIME_TELEMETRY_INTERVAL_MS=15000

# Docker selects its checked-in UI release automatically when the widget domain is configured.
# SYNC_CHATGPT_APP_RELEASES=/app/chatgpt-dist/releases.json
# SYNC_CHATGPT_APP_DOMAIN=https://mcp.sync.so
# SYNC_CHATGPT_APP_CONNECT_DOMAINS=["https://api.sync.so"]
# SYNC_CHATGPT_APP_RESOURCE_DOMAINS=[]
# Local, unpackaged frontend only:
# SYNC_CHATGPT_APP_DIR=/absolute/path/to/apps/chatgpt/dist
