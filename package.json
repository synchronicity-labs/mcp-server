{
  "name": "@sync.so/mcp-server",
  "version": "0.2.0",
  "description": "MCP server for the Sync API \u2014 give AI agents the ability to create lipsync videos, manage assets, and more",
  "keywords": [
    "mcp",
    "sync",
    "lipsync",
    "ai",
    "video",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/synchronicity-labs/mcp-server.git"
  },
  "homepage": "https://sync.so/docs",
  "bugs": {
    "url": "https://github.com/synchronicity-labs/mcp-server/issues"
  },
  "type": "module",
  "bin": {
    "mcp-server": "./dist/cli.js",
    "sync-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "claude-plugin"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsc -b && chmod +x dist/cli.js",
    "package:chatgpt": "node scripts/package-chatgpt.mjs",
    "verify:chatgpt-package": "node scripts/verify-chatgpt-package.mjs",
    "clean": "rm -rf dist .cache",
    "dev": "tsc -b --watch",
    "lint": "biome check ./src ./scripts",
    "lint:fix": "biome check --fix ./src ./scripts",
    "format": "biome format --write ./src ./scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test -- --no-file-parallelism && npm run build",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "ipaddr.js": "^2.5.0",
    "undici": "^6.29.0",
    "zod": "^4.1.13"
  },
  "overrides": {
    "hono": "^4.12.24",
    "@hono/node-server": "^1.19.13",
    "fast-uri": "^3.1.2",
    "path-to-regexp": "^8.4.2",
    "qs": "^6.15.2",
    "ip-address": "^10.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@playwright/test": "1.58.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.12"
  }
}
